---
import Layout from '../layouts/Layout.astro';
import StagingBanner from '../components/StagingBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Outcomes from '../components/Outcomes.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
import StagingReview from '../components/StagingReview.astro';
---

<Layout>
  <div class="site-chrome">
    <StagingBanner />
    <Header />
  </div>
  <main>
    <Hero />
    <Story />
    <Outcomes />
    <HowItWorks />
    <Pricing />
    <CtaBanner />
  </main>
  <Footer />
  <BookingModal />
  <StagingReview />
</Layout>
