---
const links = [
  { href: '#story', label: 'Log' },
  { href: '#outcomes', label: 'Signals' },
  { href: '#how-it-works', label: 'Protocol' },
  { href: '#pricing', label: 'Access' },
];
---

<footer class="footer">
  <div class="container footer-content">
    <div>
      <div class="footer-brand">AutoOps AI</div>
      <div class="footer-meta">Custom AI workflows for SMBs. Night desk, day hours.</div>
    </div>

    <ul class="footer-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>

    <div class="footer-copy">© 2026 AutoOps AI. All rights reserved.</div>
  </div>
</footer>
