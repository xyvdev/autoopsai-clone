---
const links = [
  { href: '#story', label: 'Before & After' },
  { href: '#outcomes', label: 'Outcomes' },
  { href: '#how-it-works', label: 'How It Works' },
  { href: '#pricing', label: 'Audit Options' },
];
---

<header class="header">
  <div class="container nav-wrapper">
    <a href="#" class="brand-logo">
      <span class="logo-icon">&gt;</span>
      AutoOps AI
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <button
        id="themeToggleBtn"
        class="btn-secondary theme-toggle"
        type="button"
        title="Toggle Theme (Auto / Dark / Light)"
      >
        <span id="themeIcon">☀️</span> <span id="themeLabel">Light</span>
      </button>
      <a href="#" class="btn-primary js-stub-cta">Book Free Audit</a>
    </div>
  </div>
</header>
