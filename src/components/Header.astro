---
const links = [
  { href: '#story', label: 'Log' },
  { href: '#outcomes', label: 'Signals' },
  { href: '#how-it-works', label: 'Protocol' },
  { href: '#pricing', label: 'Access' },
];
---

<header class="header">
  <div class="container nav-wrapper">
    <a href="#" class="brand-logo">
      <span class="logo-icon">AO</span>
      <span class="brand-lockup">
        <span class="brand-name">AutoOps AI</span>
        <span class="brand-meta">ops // night desk</span>
      </span>
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <button
        id="themeToggleBtn"
        class="btn-secondary theme-toggle"
        type="button"
        title="Toggle Theme (Auto / Dark / Light)"
      >
        <span id="themeIcon">🌙</span> <span id="themeLabel">Dark</span>
      </button>
      <a href="#" class="btn-primary js-stub-cta">Book Free Audit</a>
    </div>
  </div>
</header>
