---

<div id="stagingBanner" class="staging-banner" role="status">
  <div class="staging-banner-inner">
    <span class="staging-banner-dot" aria-hidden="true"></span>
    <p class="staging-banner-copy">
      <strong>You’re on Staging</strong>
      <span class="staging-banner-sep" aria-hidden="true">·</span>
      Review environment — not production. Booking CTAs stay stubbed.
    </p>
    <button
      id="stagingBannerDismiss"
      class="staging-banner-dismiss"
      type="button"
      aria-label="Dismiss staging banner"
    >
      Dismiss
    </button>
  </div>
</div>
