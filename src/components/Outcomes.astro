---
const outcomes = [
  { index: '01', title: 'Invoices that file themselves', signal: 'AP' },
  { index: '02', title: 'Email inboxes that draft their own replies', signal: 'INBOX' },
  { index: '03', title: 'Bookings with no back-and-forth', signal: 'CAL' },
  { index: '04', title: 'Meeting notes that log their own action items', signal: 'NOTES' },
  { index: '05', title: 'Leads that route themselves into your CRM', signal: 'CRM' },
];
---

<section id="outcomes" class="outcomes-section">
  <div class="container">
    <div class="section-header section-header-left">
      <p class="console-kicker"><span class="kicker-led" aria-hidden="true"></span> Evening freedom</p>
      <p class="section-subtitle">Automation signals</p>
      <h2 class="section-title">What would you do with your evenings back?</h2>
      <p class="section-description">Quiet background systems, integrated directly into the tools you already run.</p>
    </div>

    <ol class="outcomes-sheet">
      {outcomes.map((item) => (
        <li class="outcome-row reveal">
          <span class="outcome-index">{item.index}</span>
          <h3>{item.title}</h3>
          <span class="outcome-signal">{item.signal}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
