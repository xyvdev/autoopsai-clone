---
const before = [
  {
    index: '01',
    title: 'Maria opens shop',
    body: 'Runs a small business service center. Loves the work — sorting inbox queries, not so much.',
  },
  {
    index: '02',
    title: 'Buried in busywork',
    body: 'Every Sunday night: answering repetitive prospective client questions and sifting through general inquiries. Again.',
  },
];

const after = [
  {
    index: '03',
    title: 'AutoOps steps in',
    body: 'An AI Email Assistant working silently behind her shared inbox. No complex setup to master. No additional team needed.',
  },
  {
    index: '04',
    title: 'Sunday is Sunday again',
    body: 'Incoming emails draft their own personalized, context-aware responses automatically. She reviews & clicks Send on Monday morning.',
  },
];
---

<section id="story" class="story-section">
  <div class="container">
    <div class="section-header section-header-left">
      <p class="console-kicker"><span class="kicker-led" aria-hidden="true"></span> Case study</p>
      <p class="section-subtitle">Field log // before & after</p>
      <h2 class="section-title">One Sunday, rewritten.</h2>
      <p class="section-description">How a quiet system gives business owners their evenings and weekends back.</p>
    </div>

    <div class="story-rails">
      <div class="story-rail story-rail-before">
        <p class="rail-label">Before</p>
        {before.map((beat) => (
          <article class="story-card reveal">
            <span class="story-index">{beat.index}</span>
            <h3>{beat.title}</h3>
            <p>{beat.body}</p>
          </article>
        ))}
      </div>
      <div class="story-rail story-rail-after">
        <p class="rail-label">After</p>
        {after.map((beat) => (
          <article class="story-card story-card-after reveal">
            <span class="story-index">{beat.index}</span>
            <h3>{beat.title}</h3>
            <p>{beat.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
